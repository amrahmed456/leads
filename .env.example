APP_NAME="Leads"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=leads
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue: "database" works out of the box. Switch to "redis" when Redis and the
# phpredis extension (or predis) are available. retry_after must stay larger
# than the discovery job timeout (300s).
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=600
REDIS_QUEUE_RETRY_AFTER=600

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Business discovery
# --------------------------------------------------------------------------
DISCOVERY_DEFAULT_PROVIDER=openstreetmap
DISCOVERY_QUEUE=default
DISCOVERY_MAX_RADIUS_KM=50
DISCOVERY_DEDUPE_DISTANCE_METERS=75
# Identifies this app to OpenStreetMap services (required by their usage policies).
DISCOVERY_USER_AGENT="LeadsDiscovery/1.0 (personal business research tool)"
# Optional but recommended by Nominatim: a contact address for heavy-usage issues.
DISCOVERY_CONTACT_EMAIL=

# OpenStreetMap / Overpass API (free, no API key required)
OSM_ENABLED=true
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_OVERPASS_TIMEOUT=120
OSM_MAX_RESULTS=3000

# Nominatim geocoder (resolves a city/area to coordinates)
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_CACHE_DAYS=30

# Only if PHP cannot verify HTTPS certificates (cURL error 60/77), e.g. Laragon:
# HTTP_CA_BUNDLE="C:\laragon\etc\ssl\cacert.pem"
HTTP_CA_BUNDLE=
